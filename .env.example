# PostgreSQL connection string
# Local:   postgresql://postgres:yourpassword@localhost:5432/medicabinet
# Railway: automatically provided via $DATABASE_URL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/medicabinet

# JWT Secret (use a long random string in production)
JWT_SECRET=change_me_to_a_random_string

# Gemini AI API Key (optional)
GEMINI_API_KEY=

# App URL
APP_URL=http://localhost:3000

# SMTP for emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
